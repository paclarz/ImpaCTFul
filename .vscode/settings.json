{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "LICENSE.md": true,
    ".editorconfig": true,
    ".data": true,
    ".github": true,
    ".nuxt": true,
    ".nvmrc": true,
    ".prettierrc": true,
    "eslint.config.mjs": true,
    "tailwind.config.js": true,
    "tsconfig.json": true
  },
  "tailwindCSS.files.exclude": ["**/.git/**", "**/node_modules/**", "**/.hg/**", "**/.svn/**", "**/.nuxt/**"],
  "cSpell.words": ["cloudinary", "Namecheap", "Nuxt", "spacegrotesk", "Tailwindcss", "vuex"]
}
